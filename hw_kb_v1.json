  "concepts": [
    { "term": "단순승인", "plain": "재산도 빚도 모두 물려받는 것", "basis": "민법 제1025조" },
    { "term": "한정승인", "plain": "물려받은 재산 범위 안에서만 빚을 갚는 방식. 가정법원에 신고한다", "basis": "민법 제1028조" },
    { "term": "상속포기", "plain": "재산도 빚도 받지 않겠다고 가정법원에 신고하는 것. 다음 순위 상속인에게 넘어갈 수 있다", "basis": "민법 제1041조" },
    { "term": "상속재산 파산", "plain": "빚이 많은 상속재산을 법원이 정리하는 절차. 한정승인·포기가 가능한 기간 안에 신청할 수 있다", "basis": "채무자 회생 및 파산에 관한 법률 제299조·제300조" },
    { "term": "유류분", "plain": "상속인에게 법으로 보장된 최소 몫. 2026.3.17.부터 원칙적으로 돈(가액)으로 돌려받는다. 형제자매 유류분은 폐지됐다", "basis": "민법 제1112조·제1115조 · 헌재 2024.4.25. 2020헌가4" },
    { "term": "기여분", "plain": "돌아가신 분을 특별히 부양했거나 재산 유지·증가에 기여한 상속인에게 더 인정되는 몫", "basis": "민법 제1008조의2" },
    { "term": "특별수익", "plain": "생전에 미리 받은 증여·유증. 상속분 계산 때 미리 받은 것으로 본다", "basis": "민법 제1008조" },
    { "term": "상속권 상실 선고", "plain": "부양 의무를 저버렸거나 학대한 상속인의 상속권을 가정법원이 박탈하는 제도(2026.3.17. 시행)", "basis": "민법 제1004조의2" },
    { "term": "유언대용신탁", "plain": "살아 있을 때 재산을 신탁하고, 사후에 정해 둔 사람에게 넘기는 방식", "basis": "신탁법 제59조" },
    { "term": "장애인 신탁", "plain": "장애인 자녀 등에게 남기는 재산을 신탁으로 보호하는 방식. 일정 요건이면 증여세 과세가액에서 제외된다", "basis": "상속세 및 증여세법 제52조의2" },
    { "term": "가업승계", "plain": "사업·법인을 자녀 등에게 넘기는 것. 요건이 맞으면 가업상속공제·증여세 과세특례가 있다", "basis": "상속세 및 증여세법 제18조의2 · 조세특례제한법 제30조의6" },
    { "term": "안전관리자 선임", "plain": "일정 규모 이상 사업장은 안전관리자를 두어야 한다. 대표 유고 시 사업장 안전 공백도 승계 준비에 포함된다", "basis": "산업안전보건법 제17조 · 시행령 별표3·별표4" }
  ],

